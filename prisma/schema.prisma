// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clip {
  id          String   @id @default(cuid())
  youtubeUrl  String
  startTime   String   // format "HH:MM:SS" or seconds
  endTime     String
  format      String   @default("mp4") // mp4, mkv, webm
  quality     String   @default("1080p") // 1080p, 720p, 480p, best
  title       String?
  status      JobStatus @default(PENDING)
  downloadUrl String?  // URL to the final clip in Supabase Storage
  storagePath String?  // Internal path for cleanup
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
