generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Clip {
  id          String   @id @default(uuid())
  videoId     String
  originalUrl String
  startTime   Float
  endTime     Float
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  format      String   @default("mp4")
  quality     String?
  title       String?  // New: Store video title
  error       String?  // New: Store error message if failed
  progress    Int      @default(0) // New: Store processing progress (0-100)
  fileSize    Int?     // New: Size of the clipped file in bytes
  filePath    String?
  downloadUrl String?
  createdAt   DateTime @default(now())
}
